# Copy to .env and fill in. NEVER commit a real .env (only this template is tracked).

# --- NEAR (core) ---
NEAR_NETWORK=testnet
PURSER_CONTRACT_ID=
SIGNER_CONTRACT_ID=v1.signer-prod.testnet   # verify the testnet MPC signer id at build start

# --- NEAR AI Cloud (proposer) ---
NEAR_AI_CLOUD_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_CLOUD_API_KEY=
NEAR_AI_MODEL=z-ai/glm-5.3-flash               # canonical id of a NEAR TEE (providerType vllm) model; never an alias

# --- Proposer crew (testnet; written by scripts/deploy-testnet.sh, keys pasted by the operator) ---
NEAR_RPC_URL=https://test.rpc.fastnear.com
PROPOSER_TASK_ID=
PROPOSER_SCOUT_ACCOUNT_ID=
PROPOSER_SCOUT_FC_PRIVATE_KEY=                  # function-call key: Purser.propose_payment ONLY
PROPOSER_FORGE_ACCOUNT_ID=
PROPOSER_FORGE_FC_PRIVATE_KEY=
PROPOSER_BUYER_ACCOUNT_ID=
PROPOSER_BUYER_FC_PRIVATE_KEY=
PROPOSER_MERCHANT_DATA=                         # allowlisted vendors the personas shop from
PROPOSER_MERCHANT_COMPUTE=
PROPOSER_MERCHANT_PROCUREMENT=
PROPOSER_MERCHANT_ATTACKER=                     # NOT allowlisted: the injection demo's target

# --- Testnet demo (scripts/deploy-testnet.sh writes OPERATOR_ACCOUNT_ID into .env.testnet) ---
OPERATOR_ACCOUNT_ID=                        # <you>.testnet: owns the contract, signs owner calls via the near-cli keychain
RUN_ID=                                     # demo.sh: fresh task id suffix, [a-z0-9-]{1,32}; default = UTC timestamp
DEMO_CAP_NEAR=                              # demo.sh: task cap in NEAR (up to 3 decimals); default 1. A run pays out 0.9x of it

# --- Off-chain cache (indexer) ---
DATABASE_URL=                               # Postgres URL, or sqlite://./purser-indexer.db for local (default)
INDEXER_ENABLED=                            # 1 = the board reads history from the cache via /__indexer

# --- EVM external path (relayer; Sepolia only, never mainnet) ---
EVM_PURSER_CONTRACT_ID=                     # the EVM-enabled Purser deployment (NOT the demo PURSER_CONTRACT_ID)
EVM_RPC_URL=                                # Sepolia JSON-RPC, https only (e.g. https://rpc.example.invalid); may embed an API key: treated as a secret
EVM_RPC_URL_2=                              # second, independent Sepolia RPC: release evidence (cancel landed / original reverted) is attested only when both agree
RELAYER_ALLOW_SINGLE_RPC_EVIDENCE=          # set to 1 to attest release evidence on ONE RPC's word when EVM_RPC_URL_2 is unset; empty = withheld
RELAYER_ACCOUNT_ID=                         # <relayer>.testnet; must be the contract's get_relayer and differ from the owner
RELAYER_PRIVATE_KEY=                        # the relayer's NEAR function-call key (ed25519:...), restricted to attest_external/mark_unknown/request_cancel. NO EVM key exists anywhere. NEVER commit a real value
