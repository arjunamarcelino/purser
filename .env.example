# Copy to .env and fill in. NEVER commit a real .env (only this template is tracked).

# --- NEAR (core) ---
NEAR_NETWORK=testnet
PURSER_CONTRACT_ID=
SIGNER_CONTRACT_ID=v1.signer-prod.testnet   # verify the testnet MPC signer id at build start

# --- NEAR AI Cloud (proposer) ---
NEAR_AI_CLOUD_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_CLOUD_API_KEY=
NEAR_AI_MODEL=z-ai/glm-5.3-flash               # canonical id of a NEAR TEE (providerType vllm) model; never an alias

# --- Proposer crew (testnet; written by scripts/deploy-testnet.sh, keys pasted by the operator) ---
NEAR_RPC_URL=https://test.rpc.fastnear.com
PROPOSER_TASK_ID=
PROPOSER_SCOUT_ACCOUNT_ID=
PROPOSER_SCOUT_FC_PRIVATE_KEY=                  # function-call key: Purser.propose_payment ONLY
PROPOSER_FORGE_ACCOUNT_ID=
PROPOSER_FORGE_FC_PRIVATE_KEY=
PROPOSER_BUYER_ACCOUNT_ID=
PROPOSER_BUYER_FC_PRIVATE_KEY=
PROPOSER_MERCHANT_DATA=                         # allowlisted vendors the personas shop from
PROPOSER_MERCHANT_COMPUTE=
PROPOSER_MERCHANT_PROCUREMENT=
PROPOSER_MERCHANT_ATTACKER=                     # NOT allowlisted: the injection demo's target

# --- Off-chain cache (indexer) ---
DATABASE_URL=                               # Postgres URL, or sqlite://./purser-indexer.db for local (default)
INDEXER_ENABLED=                            # 1 = the board reads history from the cache via /__indexer

# --- EVM external path (stretch) ---
EVM_RPC_URL=                                # Sepolia
RELAYER_PRIVATE_KEY=                        # relayer service only; NEVER commit a real value
