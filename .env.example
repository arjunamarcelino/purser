# Copy to .env and fill in. NEVER commit a real .env (only this template is tracked).

# --- NEAR (core) ---
NEAR_NETWORK=testnet
PURSER_CONTRACT_ID=
SIGNER_CONTRACT_ID=v1.signer-prod.testnet   # verify the testnet MPC signer id at build start

# --- NEAR AI Cloud (proposer) ---
NEAR_AI_CLOUD_BASE_URL=
NEAR_AI_CLOUD_API_KEY=

# --- Off-chain cache (indexer) ---
DATABASE_URL=                               # Postgres URL, or sqlite://./purser.db for local

# --- EVM external path (stretch) ---
EVM_RPC_URL=                                # Sepolia
RELAYER_PRIVATE_KEY=                        # relayer service only; NEVER commit a real value
