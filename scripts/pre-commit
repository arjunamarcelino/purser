#!/usr/bin/env bash
set -euo pipefail

# Fast, high-precision local backstop. The authoritative scan is the gitleaks CI job,
# which handles entropy and raw key material (bare hex, AWS secrets) with proper allowlisting.
# Scan ONLY added lines (avoids false-triggers on removed/context lines).
added="$(git diff --cached -U0 | grep '^+' | grep -v '^+++' || true)"

# High-signal key material: NEAR ed25519 secret keys, PEM private keys, AWS access-key ids.
if printf '%s\n' "$added" | grep -nE \
  'ed25519:[A-Za-z0-9]{40,}|-----BEGIN [A-Z ]*PRIVATE KEY-----|AKIA[0-9A-Z]{16}'; then
  echo "✋ Possible secret key in staged additions. Commit aborted (override with --no-verify only if sure)."
  exit 1
fi

# Secret-looking assignment with a real, non-empty, non-comment value (e.g. FOO_PRIVATE_KEY=abc...).
# Matches the name only when followed by : or = and a 12+ char value, so prose mentions and
# empty template vars (e.g. RELAYER_PRIVATE_KEY= in .env.example) do NOT trigger.
if printf '%s\n' "$added" | grep -nEi \
  '(private_key|secret_key|mnemonic|seed_phrase)[[:space:]]*[:=][[:space:]]*[^[:space:]#]{12,}'; then
  echo "✋ Possible secret value in staged additions. Commit aborted (override with --no-verify only if sure)."
  exit 1
fi

# URL-embedded credentials, e.g. a DB/relayer connection string carrying user:pass@host.
# High-precision: won't match Cargo.lock checksums or bare hashes (gitleaks covers those in CI).
if printf '%s\n' "$added" | grep -nE \
  '[a-zA-Z][a-zA-Z0-9+.-]*://[^/:@[:space:]]+:[^/@[:space:]]+@'; then
  echo "✋ Possible URL-embedded credential in staged additions. Commit aborted (override with --no-verify only if sure)."
  exit 1
fi

# Never allow a real .env (allow .env.example).
if git diff --cached --name-only | grep -E '(^|/)\.env($|\.)' | grep -v '\.env\.example$'; then
  echo "✋ A .env file is staged. Commit aborted."
  exit 1
fi
